  23. check whether pydantic setting is there in the project
      by typing this in the terminal (uv tree) what pydantic setting doing
      is making above env keys into a text.

  24. add following in the config.py
from urllib.parse import quote_plus

from pydantic_settings import BaseSettings,SettingsConfigDict

class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file='.env')

    mysql_user: str
    mysql_password: str
    mysql_host: str
    mysql_port: int
    mysql_database: str

    def database_url(self) -> str:
        return (
            f"mysql+pymysql://{self.mysql_user}:{quote_plus(self.mysql_password)}"
            f"@{self.mysql_host}:{self.mysql_port}/{self.mysql_database}"
        )
settings = Settings()

print(settings.model_config.items())
  25. uv run python config.py
  26. visit https://docs.sqlalchemy.org/en/20/orm/quickstart.html#create-an-engine
  27. create new file called python check_database.py
     from sqlalchemy import create_engine, text
from config import settings

engine = create_engine(settings.database_url)

with engine.connect() as connection:
    connection.execute(text("select 1"))

print("connection is successful|")

